---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import BusinessInfo from "../components/BusinessInfo.astro";
import { site } from "../content/site";
import { displayPhone, formatHours } from "../lib/format";

// Contact channels all come from site.ts (contactFormUrl, author.email,
// business.telephone, a line.me URL in sameAs); this page only decides the
// order. No form JS is shipped — an external form is a plain link.
// TODO(setup): Q7 問い合わせ方法の優先順位と、返信の目安などの案内文
const title = "お問い合わせ";
const description = `${site.name}へのお問い合わせ方法のご案内です。`;
const lead = "ご質問・ご相談はお気軽にどうぞ。通常2営業日以内にご返信します。";

const tel = site.business?.telephone;
const hours = site.business?.openingHours?.map(formatHours).join(" / ");
const line = site.sameAs?.find((url) => new URL(url).hostname === "line.me");
const email = site.author.email;
const form = site.contactFormUrl;
---

<Base title={title} description={description} canonicalPath="/contact">
  <PageHeader kanji="問" en="Contact" title={title} description={lead} />

  <section class="section contact">
    <div class="container-page contact__container">
      {
        (tel || line) && (
          <div class="contact-quick fade-in stagger-4">
            {tel && (
              <div class="contact-quick__card">
                <p class="contact-quick__label">お電話で</p>
                <a href={`tel:${tel}`} class="contact-quick__tel">
                  {displayPhone(tel)}
                </a>
                {hours && <p class="contact-quick__note">受付時間：{hours}</p>}
              </div>
            )}
            {line && (
              <div class="contact-quick__card">
                <p class="contact-quick__label">LINEで</p>
                <a
                  href={line}
                  target="_blank"
                  rel="noopener"
                  class="btn btn--line"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M21 10.5c0-4.69-4.03-8.5-9-8.5s-9 3.81-9 8.5c0 4.2 3.14 7.74 7.42 8.39.85.13 1.99.4 2.15 1.15.05.23.01.68-.13 1.1-.19.55-.91 2.66-.91 2.66s-.06.26.15.38.45.06.6.01c.15-.05 3.3-1.66 4.6-2.5 1.94-1.26 3.12-2.9 3.12-5.18z" />
                  </svg>
                  LINEで相談する
                </a>
              </div>
            )}
          </div>
        )
      }

      {
        (form || email) && (
          <div class="contact-main fade-in">
            <h2 class="contact-main__title">
              {form ? "WEBフォームから" : "メールで"}
            </h2>
            {form ? (
              <>
                <p class="contact-main__note">
                  フォームが別のページで開きます。必要事項をご記入のうえ送信してください。
                </p>
                <a
                  href={form}
                  target="_blank"
                  rel="noopener"
                  class="btn btn--dark btn--large"
                >
                  お問い合わせフォームを開く
                  <span class="btn__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
                {email && (
                  <p class="contact-main__sub">
                    メールでも承っています：
                    <a href={`mailto:${email}`}>{email}</a>
                  </p>
                )}
              </>
            ) : (
              <a href={`mailto:${email}`} class="contact-main__mail">
                {email}
              </a>
            )}
          </div>
        )
      }

      {
        site.business && (
          <div class="contact-business fade-in">
            <BusinessInfo />
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-top: 2rem;
    padding-bottom: 8rem;
  }

  .contact__container {
    max-width: 800px;
  }

  /* Tel / LINE */
  .contact-quick {
    display: flex;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .contact-quick__card {
    flex: 1;
    background-color: var(--color-surface);
    padding: 2.5rem 2rem;
    border-radius: 4px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px color-mix(in srgb, var(--color-fg) 2%, transparent);
  }

  .contact-quick__label {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .contact-quick__tel {
    font-family: var(--font-en);
    font-size: 2.5rem;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.5rem;
    transition: opacity var(--transition-base);
  }

  .contact-quick__tel:hover {
    opacity: 0.7;
  }

  .contact-quick__note {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .btn--line {
    background-color: var(--color-line);
    color: var(--color-on-dark);
    width: 100%;
    max-width: 250px;
  }

  .btn--line:hover {
    background-color: var(--color-line-hover);
    transform: translateY(-2px);
  }

  /* Form / Mail */
  .contact-main {
    text-align: center;
    margin-bottom: 4rem;
  }

  .contact-main__title {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .contact-main__note {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  .btn--large {
    padding: 1.2rem 4rem;
    font-size: 1.1rem;
  }

  .contact-main__sub {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .contact-main__sub a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .contact-main__mail {
    font-family: var(--font-en);
    font-size: clamp(1.4rem, 5vw, 2rem);
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 768px) {
    .contact-quick {
      flex-direction: column;
    }

    .btn--large {
      padding: 1rem 2rem;
    }
  }
</style>
