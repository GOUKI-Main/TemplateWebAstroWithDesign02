---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { site } from "../content/site";

// Full-screen opening photo with the logo, the tagline and a sub copy.
// Pair with <Base hero> so the fixed header starts transparent over it.
const {
  image,
  alt,
  copy = site.tagline,
  sub,
} = Astro.props as {
  image: ImageMetadata;
  /** Describe the photo; "" if it is purely decorative. */
  alt: string;
  /** The page's <h1>. Defaults to site.tagline. */
  copy?: string;
  sub?: string;
};
---

{
  /* ヒーローは汎用リビールではなく、ローダーから続く専用タイムライン（playHero）が担当する */
}
<section class="hero" data-hero>
  <div class="hero__image-wrap" data-parallax="10">
    <Image
      src={image}
      alt={alt}
      class="hero__image"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1280, 1920]}
      sizes="100vw"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content container-page">
    <div class="hero__logo-wrap" data-hero-logo aria-hidden="true">
      <span class="hero__kanji">{site.brandMark}</span>
      <div class="hero__logo-text">
        <span class="hero__logo-en">{site.nameEn}</span>
        <span class="hero__logo-ja">{site.name}</span>
      </div>
    </div>

    <h1 class="hero__copy" data-hero-copy>{copy}</h1>
    {
      sub && (
        <p class="hero__subcopy" data-hero-sub>
          {sub}
        </p>
      )
    }
  </div>

  <div class="hero__scroll" data-hero-scroll aria-hidden="true">
    <span class="hero__scroll-text">( Scroll Down )</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* GSAP のパララックスで上下に動かすため、あらかじめ上下を伸ばして
     端が見えないようにする。ケンバーンズは内側の img が担当し、
     transform の二重適用を避ける */
  .hero__image-wrap {
    position: absolute;
    inset: -18% 0;
    z-index: 1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: zoom 20s infinite alternate linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      animation: none;
    }
  }

  @keyframes zoom {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.1);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-dark) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-dark) 70%, transparent) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    color: var(--color-on-dark);
  }

  .hero__logo-wrap {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 25dvh;
  }

  .hero__kanji {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .hero__logo-text {
    display: flex;
    flex-direction: column;
  }

  .hero__logo-en {
    font-family: var(--font-en);
    font-size: 1rem;
    letter-spacing: 0.25em;
    opacity: 0.8;
  }

  .hero__logo-ja {
    font-size: 1.1rem;
    letter-spacing: 0.15em;
  }

  .hero__copy {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    line-height: 1.4;
  }

  .hero__subcopy {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .hero__scroll {
    position: absolute;
    bottom: 3rem;
    right: var(--section-padding-x);
    z-index: 2;
    font-family: var(--font-en);
    font-size: 0.9rem;
    color: var(--color-on-dark);
    letter-spacing: 0.1em;
  }

  /* .anim-on の時だけ伏せる。JS が動かない環境では最初から見えている */
  :global(html.anim-on) .hero__logo-wrap,
  :global(html.anim-on) .hero__copy,
  :global(html.anim-on) .hero__subcopy,
  :global(html.anim-on) .hero__scroll {
    opacity: 0;
  }

  @media (max-width: 768px) {
    .hero__logo-wrap {
      margin-bottom: 20dvh;
    }
  }
</style>
