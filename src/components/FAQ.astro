---
import SectionHeading from "./SectionHeading.astro";

// Accessible FAQ using native <details>/<summary> — opens and closes with no
// JavaScript. (§7)
// NOTE: Google removed FAQ rich results (2026-05), so this is for user value
// and page understanding — not for a rich-result snippet. No FAQPage JSON-LD.
type QA = { q: string; a: string };
const {
  items,
  heading = "よくある質問",
  kanji = "問",
  en = "FAQ",
  index,
} = Astro.props as {
  items: QA[];
  /** 読み上げ用の見出し名（画面には漢字と英字が出る） */
  heading?: string;
  kanji?: string;
  en?: string;
  /** セクション連番（例: "04"） */
  index?: string;
};
---

<section class="section faq" aria-label={heading}>
  <div class="container-page faq__container">
    <SectionHeading kanji={kanji} en={en} index={index} label={heading} />

    <div class="faq__list">
      {
        items.map((item, i) => (
          <details class:list={["faq__item fade-in", `stagger-${(i % 4) + 1}`]}>
            <summary class="faq__q">
              <span class="faq__mark" aria-hidden="true">
                Q.
              </span>
              <span class="faq__q-text">{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <span class="faq__mark" aria-hidden="true">
                A.
              </span>
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__container {
    max-width: 960px;
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__q {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.6rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    transition: color var(--transition-base);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--color-accent);
  }

  .faq__q-text {
    flex: 1;
  }

  .faq__mark {
    flex-shrink: 0;
    font-family: var(--font-en);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-accent);
  }

  /* 罫線2本で作る「＋」。開くと縦線が寝て「−」になる */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    align-self: center;
    width: 14px;
    height: 14px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transition: transform var(--transition-base);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0 0.25rem 1.8rem;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .faq__a .faq__mark {
    color: var(--color-cta-hover);
  }
</style>
