---
import { site } from "../content/site";
import { displayPhone, formatAddress } from "../lib/format";

const { author, business } = site;
const year = new Date().getFullYear();
const address = formatAddress(business?.address);

// Brand profiles (site.sameAs) first, then the author's own; de-duplicated so
// the same account listed in both places renders once. Labels (and icons)
// come from the host, so adding a URL in site.ts is all it takes.
const LABELS: Record<string, string> = {
  "x.com": "X",
  "twitter.com": "X",
  "instagram.com": "Instagram",
  "facebook.com": "Facebook",
  "youtube.com": "YouTube",
  "tiktok.com": "TikTok",
  "line.me": "LINE",
  "note.com": "note",
  "github.com": "GitHub",
  "linkedin.com": "LinkedIn",
};
// Outline icons (24×24, stroke = currentColor) for the profiles that have one;
// anything else is shown as a text pill.
const ICONS: Record<string, string> = {
  Instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>',
  LINE: '<path d="M21 10.5c0-4.69-4.03-8.5-9-8.5s-9 3.81-9 8.5c0 4.2 3.14 7.74 7.42 8.39.85.13 1.99.4 2.15 1.15.05.23.01.68-.13 1.1-.19.55-.91 2.66-.91 2.66s-.06.26.15.38.45.06.6.01c.15-.05 3.3-1.66 4.6-2.5 1.94-1.26 3.12-2.9 3.12-5.18z"></path>',
  X: '<path d="M4 4l16 16M20 4L4 20"></path>',
  Facebook:
    '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>',
  YouTube:
    '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>',
};
const labelFor = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  return LABELS[host] ?? host;
};
const profiles = [
  ...new Set([
    ...(site.sameAs ?? []),
    ...(Object.values(author.socials ?? {}).filter(Boolean) as string[]),
  ]),
].map((url) => {
  const label = labelFor(url);
  return { url, label, icon: ICONS[label] };
});

// Site pages first, then policy pages.
const links = [...site.nav, ...(site.footerNav ?? [])];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__info fade-in">
        <a href="/" class="footer__logo">
          <span class="footer__logo-name">{site.name}</span>
          <span class="footer__logo-en" aria-hidden="true">{site.nameEn}</span>
        </a>
        {address && <p class="footer__address">{address}</p>}
        {
          business?.telephone && (
            <p class="footer__tel">
              <a href={`tel:${business.telephone}`}>
                {displayPhone(business.telephone)}
              </a>
            </p>
          )
        }
        {
          author.email && (
            <p class="footer__mail">
              <a href={`mailto:${author.email}`}>{author.email}</a>
            </p>
          )
        }
      </div>

      <nav
        class="footer__nav fade-in stagger-1"
        aria-label="フッターナビゲーション"
      >
        <ul class="footer__nav-list">
          {
            links.map((item) => (
              <li class="footer__nav-item">
                <a href={item.href} class="footer__nav-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        profiles.length > 0 && (
          <div class="footer__social fade-in stagger-2">
            <p class="footer__social-title">Follow Us</p>
            <div class="footer__social-links">
              {profiles.map((p) =>
                p.icon ? (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={p.label}
                    class="footer__social-icon"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="24"
                      height="24"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={p.icon}
                    />
                  </a>
                ) : (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    class="footer__social-text"
                  >
                    {p.label}
                  </a>
                ),
              )}
            </div>
          </div>
        )
      }
    </div>

    <div class="footer__bottom">
      {
        /* The rights holder is the business, not the person running the site. */
      }
      <p class="footer__copyright">
        {`© ${year} ${business?.legalName ?? site.name}`}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    padding: clamp(4rem, 8vw, 6rem) 0 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--section-padding-x);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .footer__logo {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--color-fg);
  }

  .footer__logo-name {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    line-height: 1.2;
  }

  .footer__logo-en {
    font-family: var(--font-en);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .footer__address {
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .footer__tel {
    font-family: var(--font-en);
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .footer__mail {
    font-size: 0.9rem;
    margin-top: -0.75rem;
  }

  .footer__nav-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
  }

  .footer__nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: 0.95rem;
    color: var(--color-fg);
  }

  .footer__nav-link:hover,
  .footer__logo:hover,
  .footer__tel a:hover,
  .footer__mail a:hover {
    color: var(--color-accent);
  }

  .footer__social-title {
    font-family: var(--font-en);
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .footer__social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__social-icon,
  .footer__social-text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    transition: all var(--transition-base);
  }

  .footer__social-icon {
    width: 2.75rem;
    border-radius: 50%;
  }

  .footer__social-icon svg {
    width: 20px;
    height: 20px;
  }

  .footer__social-text {
    padding: 0 1.1rem;
    border-radius: 50px;
    font-family: var(--font-en);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .footer__social-icon:hover,
  .footer__social-text:hover {
    background-color: var(--color-fg);
    color: var(--color-on-dark);
  }

  .footer__bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer__copyright {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-family: var(--font-en);
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer__nav-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer__nav-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
