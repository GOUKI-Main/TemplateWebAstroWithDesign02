---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// 写真 + 丸い漢字バッジ + タイトル・説明のカード。トップの「提供しているもの」用。
// href があればカード全体がリンクになる。
const { kanji, en, name, label, summary, href, image, alt } = Astro.props as {
  /** 写真の左上に出す漢字1字 */
  kanji: string;
  /** 右上の英字（例: "Lunch"） */
  en: string;
  name: string;
  /** 左上の小さな補足（対象・価格帯など） */
  label?: string;
  summary: string;
  /** 詳しいページへのリンク。無ければリンクにしない */
  href?: string;
  image: ImageMetadata;
  /** 写真の説明。省略時は name */
  alt?: string;
};
const Tag = href ? "a" : "div";
---

{
  /* リビールは呼び出し側のラッパー（.fade-in.stagger-N）が担当するため、
    ここでは付けない（二重フェードを避ける） */
}
<Tag href={href} class:list={["service-card", { "is-link": href }]}>
  <div class="service-card__image-wrap">
    <Image
      src={image}
      alt={alt ?? name}
      class="service-card__image"
      widths={[400, 800]}
      sizes="(max-width: 768px) 100vw, 33vw"
    />
    <div class="service-card__kanji-wrap" aria-hidden="true">
      <span class="service-card__kanji">{kanji}</span>
    </div>
  </div>

  <div class="service-card__content">
    <div class="service-card__header">
      {label && <p class="service-card__label">{label}</p>}
      <p class="service-card__en" aria-hidden="true">{en}</p>
    </div>

    <h3 class="service-card__title">{name}</h3>
    <p class="service-card__summary">{summary}</p>

    {
      href && (
        <div class="more-link" aria-hidden="true">
          <span class="more-link__text">View Details</span>
          <span class="more-link__arrow">→</span>
        </div>
      )
    }
  </div>
</Tag>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-fg);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
    height: 100%;
  }

  .service-card.is-link:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px color-mix(in srgb, var(--color-fg) 8%, transparent);
  }

  .service-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .service-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .service-card.is-link:hover .service-card__image {
    transform: scale(1.05);
  }

  .service-card__kanji-wrap {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 3rem;
    height: 3rem;
    background-color: var(--color-dark);
    color: var(--color-on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .service-card__kanji {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  .service-card__content {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .service-card__label {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .service-card__en {
    margin-left: auto;
    font-family: var(--font-en);
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.1em;
  }

  .service-card__title {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .service-card__summary {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .more-link {
    margin-top: auto;
    align-self: flex-start;
    font-size: 0.9rem;
  }
</style>
