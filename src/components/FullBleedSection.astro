---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";

// 画面幅いっぱいの写真 + 暗幕の上に、見出しと本文（slot）を載せるセクション。
// 背景はパララックス、右下の大きな英字は横にゆっくり流れる。
const { image, kanji, en, label, largeText, index } = Astro.props as {
  image: ImageMetadata;
  kanji: string;
  en: string;
  /** SectionHeading の label（読み上げ用の見出し名） */
  label?: string;
  /** 右下に大きく出す英字（例: "Reasons"） */
  largeText: string;
  /** セクション連番（例: "02"） */
  index?: string;
};
---

{
  /* セクション全体をフェードさせると背景ごと平坦に見えるため、
    背景はパララックス、中身は個別リビールに分ける */
}
<section class="full-bleed">
  <div class="full-bleed__bg">
    <Image
      src={image}
      alt=""
      class="full-bleed__bg-image"
      widths={[640, 1280, 1920]}
      sizes="100vw"
      data-parallax="12"
    />
  </div>
  <div class="full-bleed__overlay"></div>

  <div class="full-bleed__content">
    <SectionHeading kanji={kanji} en={en} index={index} label={label} />

    <div class="full-bleed__text">
      <slot />
    </div>
  </div>

  <div class="full-bleed__large-text" data-drift="6" aria-hidden="true">
    {largeText}
  </div>
</section>

<style>
  .full-bleed {
    position: relative;
    width: 100%;
    min-height: 70dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-bottom: 4rem;
  }

  .full-bleed__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* パララックスで上下に動かすため、コンテナより縦を大きく取って
     端が見えないようにする */
  .full-bleed__bg-image {
    position: absolute;
    top: -15%;
    left: 0;
    width: 100%;
    height: 130%;
    object-fit: cover;
  }

  .full-bleed__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--overlay);
  }

  .full-bleed__content {
    position: relative;
    z-index: 2;
    color: var(--color-on-dark);
    padding: var(--section-padding) var(--section-padding-x);
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
  }

  .full-bleed__text {
    max-width: 600px;
    margin-top: 2rem;
  }

  .full-bleed__large-text {
    position: absolute;
    right: var(--section-padding-x);
    bottom: 2rem;
    font-family: var(--font-en);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 300;
    font-style: italic;
    color: var(--color-on-dark);
    opacity: 0.9;
    line-height: 1;
    z-index: 2;
    pointer-events: none;
  }

  /* 暗い面の上ではフォーカスリングを明色に */
  .full-bleed :global(:focus-visible) {
    outline-color: var(--color-cta);
  }

  /* 見出しの補助テキストは既定でミュート色のため、暗い背景の上では
     読みにくい。ここだけ明色に上書きする */
  .full-bleed :global(.section-heading__en),
  .full-bleed :global(.section-heading__index) {
    color: color-mix(in srgb, var(--color-on-dark) 72%, transparent);
  }

  .full-bleed :global(.section-heading__index::after) {
    background-color: color-mix(in srgb, var(--color-on-dark) 35%, transparent);
  }

  @media (max-width: 768px) {
    .full-bleed {
      min-height: 60dvh;
    }

    .full-bleed__large-text {
      font-size: 3rem;
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }
</style>
